@model DeleteSectionViewModel

@{
    ViewData["Title"] = "Bölüm Sil";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl max-w-2xl mx-auto">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-rose-300/30 text-rose-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
    </div>

    <div class="relative z-10 space-y-6">
        <div class="flex flex-col items-center text-center space-y-3">
            <div class="w-14 h-14 rounded-2xl bg-rose-50 border-2 border-rose-100 text-rose-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-lg font-extrabold text-gray-900">
                    Bu bölümü silmek istediğinizden emin misiniz?
                </h2>
                <p class="text-xs font-medium text-gray-500 mt-1">
                    @if (Model.LessonCount > 0)
                    {
                        <text>Bu bölümde @Model.LessonCount ders bulunmaktadır. Bölümü silerseniz, bu dersler de silinecektir.</text>
                    }
                    else
                    {
                        <text>Bu bölümde ders bulunmamaktadır.</text>
                    }
                </p>
            </div>
        </div>

        <div class="bg-gray-50 border-2 border-gray-200 rounded-2xl p-6 space-y-3">
            <div>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Kurs</span>
                <p class="text-base font-bold text-gray-900">@Model.CourseTitle</p>
            </div>
            <div class="border-t-2 border-gray-200 pt-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Bölüm</span>
                <p class="text-sm leading-6 text-gray-600">@Model.Title</p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <form asp-controller="CourseSections" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CourseId" />

                <button class="h-12 w-full flex items-center justify-center bg-rose-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-rose-600 font-bold text-white rounded-xl" type="submit">Evet, Sil</button>
            </form>

            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="h-12 px-4 flex items-center justify-center bg-white border-2 border-b-4 text-sm active:border-b-2 border-gray-200 font-bold text-gray-500 rounded-xl">Hayır, Geri Dön</a>
        </div>
    </div>
</section>