@model HomeViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-10 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="home-hero-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#home-hero-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-10">
        <div class="space-y-4 max-w-2xl">
            <h1 class="text-4xl font-black tracking-tight text-gray-900 leading-tight">
                Ders materyallerini düzenli takip et, ilerlemeni ölç ve rozetler kazan.
            </h1>
            <p class="text-sm text-gray-500 leading-relaxed">
                EduApp ile öğretim elemanlarının hazırladığı kurslara tek yerden ulaşın, bölümler halinde ilerleyin ve tamamlama istatistiklerinizi anlık takip edin.
            </p>

            <form method="get" asp-controller="Courses" asp-action="Index" class="flex items-center space-x-4 pt-2">
                <input type="text"
                       name="search"
                       placeholder="Kurs adı, kategori veya eğitmen adına göre arayın..."
                       class="h-12 w-full flex items-center px-4 bg-white rounded-2xl border-2 border-gray-200 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <button type="submit" class="h-12 px-5 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm active:border-b-2 border-indigo-600 font-bold text-white rounded-xl shrink-0 cursor-pointer">
                    Kurs Ara
                </button>
            </form>
        </div>

        <div class="grid grid-cols-1 gap-3 w-64 shrink-0">
            <div class="rounded-2xl border-2 border-gray-200 bg-white p-4 flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wide text-gray-500">Aktif Kurs</span>
                <span class="text-2xl font-extrabold text-indigo-500">@Model.TotalCourseCount</span>
            </div>
            <div class="rounded-2xl border-2 border-gray-200 bg-white p-4 flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wide text-gray-500">Kategori</span>
                <span class="text-2xl font-extrabold text-orange-500">@Model.TotalCategoryCount</span>
            </div>
            <div class="rounded-2xl border-2 border-gray-200 bg-white p-4 flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Ders</span>
                <span class="text-2xl font-extrabold text-emerald-500">@Model.TotalLessonCount</span>
            </div>
        </div>
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold">Kategoriler</h2>
                <p class="text-sm font-light text-gray-500">İlgi alanınıza göre kursları filtreleyin.</p>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="text-xs font-bold text-indigo-500 hover:text-indigo-700">
                Tümünü Gör
            </a>
        </div>

        <div class="flex flex-wrap gap-2">
            @foreach (var category in Model.Categories)
            {
                <a asp-controller="Courses" asp-action="Index" asp-route-categoryId="@category.Id"
                   class="inline-flex items-center space-x-2 rounded-full bg-white border-2 border-gray-200 hover:border-indigo-500 px-4 py-2 text-xs font-bold text-gray-600 hover:text-indigo-500">
                    <span>@category.Name</span>
                    <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-[11px] text-indigo-500">@category.CourseCount</span>
                </a>
            }
        </div>
    </section>
}

<section class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold">Son Eklenen Kurslar</h2>
            <p class="text-sm font-light text-gray-500">Platforma en son eklenen ders ve materyalleri keşfedin.</p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="h-11 px-4 flex items-center justify-center bg-white border-2 border-b-4 text-sm active:border-b-2 border-gray-200 font-bold text-gray-500 rounded-xl shrink-0">
            Tüm Kurslar
        </a>
    </div>

    <div class="grid grid-cols-3 gap-4">
        @if (Model.LatestCourses.Count == 0)
        {
            <div class="flex flex-col items-center justify-center col-span-3 space-y-4 text-gray-500 p-8">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <p class="text-gray-500 text-sm">Henüz kurs eklenmemiştir.</p>
            </div>
        }
        else
        {
            @foreach (var course in Model.LatestCourses)
            {
                <article class="bg-white border-2 border-gray-200 rounded-2xl p-4 flex flex-col group">
                    <div class="relative overflow-hidden rounded-xl h-42 mb-3 bg-gray-100">
                        <img src="@(string.IsNullOrWhiteSpace(course.CoverImagePath)
                                    ? "https://placehold.co/600x400/E1E7FF/4F46E5?text=Kurs+Görseli"
                                    : course.CoverImagePath)"
                             alt="@course.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5">
                            <span class="bg-indigo-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@course.CategoryName</span>
                            @switch (course.Level)
                            {
                                case CourseLevel.Beginner:
                                    <span class="bg-gray-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Beginner.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Intermediate:
                                    <span class="bg-amber-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Intermediate.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Advanced:
                                    <span class="bg-rose-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Advanced.ToDisplayName()</span>
                                    break;
                            }
                        </div>
                        <div class="absolute bottom-2.5 right-2.5 bg-white/90 backdrop-blur-xs text-gray-800 text-[11px] font-semibold px-2 py-0.5 rounded-lg shadow-xs">
                            @course.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-bold leading-tight group-hover:text-indigo-500">@course.Name</div>
                            <p class="text-xs font-light text-gray-500 mt-1.5 line-clamp-3">
                                @(course.Description.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-gray-100 flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                @if (!string.IsNullOrWhiteSpace(course.InstructorProfileImagePath))
                                {
                                    <img src="@course.InstructorProfileImagePath" alt="@course.InstructorName" class="w-6 h-6 rounded-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 text-[10px] font-bold flex items-center justify-center select-none">
                                        @(string.IsNullOrWhiteSpace(course.InstructorName) ? "E" : course.InstructorName[0].ToString().ToUpper())
                                    </div>
                                }
                                <span class="text-xs font-medium">@course.InstructorName</span>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="flex items-center space-x-1 px-3.5 py-2 rounded-xl bg-indigo-50 text-indigo-500 text-xs font-bold hover:bg-indigo-500 hover:text-white">
                                <span>İncele</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            }
        }
    </div>
</section>