@model CreateLessonViewModel
@{
    ViewData["Title"] = "Yeni Ders Ekle";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl max-w-2xl mx-auto">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-44 z-0 opacity-60">
        <svg class="h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
        <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 space-y-6">
        <div class="flex flex-col items-center text-center space-y-6">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
            <div>
                <h2 class="text-2xl font-extrabold text-gray-900">
                    Yeni Ders Ekle
                </h2>
                <div class="text-xs font-medium text-gray-500 max-w-sm mt-2">
                    <strong>Kurs:</strong> @Model.CourseTitle - <strong>Bölüm:</strong> @Model.SectionTitle
                </div>
            </div>
        </div>

        <form asp-controller="Lessons" asp-action="Create" asp-route-sectionId="@Model.CourseSectionId" enctype="multipart/form-data" method="post" class="space-y-6">     
            <input type="hidden" asp-for="CourseSectionId" />
            <input type="hidden" asp-for="CourseId" />       

            <div class="space-y-1.5">
                <label asp-for="Title" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Bölüm Başlığı</label>
                <input asp-for="Title" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="Title" class="text-xs text-rose-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="Content" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Bölüm İçeriği</label>
                <textarea asp-for="Content" rows="10" class="h-40 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"></textarea>
                <span asp-validation-for="Content" class="text-xs text-rose-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="MaterialFile" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Ders Materyali</label>
                <input asp-for="MaterialFile" type="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.zip" class="cursor-pointer block w-full bg-white border-2 border-gray-200 rounded-lg text-xs text-gray-500 placeholder:text-gray-400 focus:outline-hidden focus:border-indigo-500 focus:ring-0.5 focus:ring-indigo-500
                        file:bg-indigo-50
                        file:text-indigo-500
                        file:font-bold
                        file:uppercase
                        file:cursor-pointer
                        file:me-4
                        file:py-3 file:px-4">
                <p class="text-xs text-gray-500">
                    İzin verilen dosya türleri: PDF, DOC, DOCX, PPT, PPTX ve ZIP.
                </p>
                <span asp-validation-for="MaterialFile" class="text-xs text-rose-500"></span>
            </div>

            <div class="flex items-center justify-end gap-4 border-t-2 border-gray-200 pt-4 mb-0">
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="h-11 px-4 flex items-center justify-center bg-white border-2 border-b-4 text-sm active:border-b-2 border-gray-200 font-bold text-gray-500 rounded-xl shrink-0">
                    Vazgeç
                </a>

                <button type="submit" class="h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">
                    Yeni Ders Ekle
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const materialInput = document.querySelector('input[name="MaterialFile"]');

        materialInput.addEventListener('change', function () {
            const file = this.files[0];

            if (!file) return;

            const maximumSize = 10 * 1024 * 1024;

            if (file.size > maximumSize) {
                alert('Dosya boyutu 10 MB\'yi geçemez.');
                this.value = '';
            }
        });
    </script>
}