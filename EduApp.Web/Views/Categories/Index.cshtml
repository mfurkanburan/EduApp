@model List<CategoryListItemViewModel>
@{
    ViewData["Title"] = "Kategoriler";
}

<h1>Kategoriler</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Yeni Kategori Ekle</a>

@if (Model.Count == 0)
{
    <p class="text-muted">
        Henüz kategori eklenmemiş. <a asp-action="Create">Yeni kategori eklemek için tıklayın.</a>
    </p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Kategori</th>
                <th>Kurs Sayısı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.CourseCount</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-primary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}