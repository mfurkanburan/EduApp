@model List<CategoryListItemViewModel>

@{
    ViewData["Title"] = "Kategoriler";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-8 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="categories-banner-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#categories-banner-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-6">
        <div class="flex items-center space-x-5">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Kategoriler</h1>
                <p class="text-sm font-light text-gray-500 mt-0.5">Yeni kategoriler ekleyin ve mevcut kurs sınıflandırmasını yönetin.</p>
            </div>
        </div>

        <a asp-controller="Categories" asp-action="Create" class="h-11 px-5 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2 mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>Yeni Kategori Ekle</span>
        </a>
    </div>
</section>

<section>
    @if (Model.Count == 0)
    {
        <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-16 rounded-2xl">
            <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <defs>
                        <pattern id="categories-empty-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                            <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                            <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" stroke-width="0" fill="url(#categories-empty-grid)"></rect>
                </svg>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                    </svg>
                </div>
                <h2 class="text-lg font-extrabold text-gray-900">Henüz kategori eklenmemiş</h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm">
                    Kursları düzenli sınıflandırmak için ilk kategorinizi oluşturun.
                </p>
                <a asp-controller="Categories" asp-action="Create" class="mt-2 h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
                    İlk Kategoriyi Ekle
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-4 gap-4">
            @foreach (var category in Model)
            {
                <div class="group flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-4 hover:border-indigo-500">
                    <div>
                        <div class="mb-4 flex items-center justify-between">
                            <div class="flex size-12 items-center justify-center rounded-2xl border-2 border-indigo-100 bg-indigo-50 text-lg font-extrabold text-indigo-500 group-hover:border-indigo-500 group-hover:bg-indigo-500 group-hover:text-white">
                                @category.Name.FirstOrDefault()
                            </div>

                            <span class="inline-flex items-center gap-2 rounded-full border-2 border-indigo-100 bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-500">
                                <span class="size-1.5 rounded-full bg-indigo-500"></span>
                                <span>@category.CourseCount Kurs</span>
                            </span>
                        </div>

                        <h2 class="text-lg font-extrabold text-gray-900 group-hover:text-indigo-500">
                            @category.Name
                        </h2>
                    </div>

                    <div class="mt-4 grid grid-cols-2 gap-2 border-t-2 border-gray-200 pt-4">
                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="h-9 px-4 flex items-center justify-center space-x-2 bg-indigo-100 text-indigo-500 text-xs font-bold hover:bg-indigo-500 hover:text-white rounded-xl">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                            <span>Düzenle</span>
                        </a>
                        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="h-9 px-4 flex items-center justify-center space-x-2 bg-rose-100 text-rose-500 text-xs font-bold hover:bg-rose-500 hover:text-white rounded-xl">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 1-7.5 0"></path>
                            </svg>
                            <span>Sil</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</section>