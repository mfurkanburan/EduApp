@model DeleteCategoryViewModel
@{
    ViewData["Title"] = "Kategori Sil";
}

<h1>Kategori Sil</h1>

<ul class="list-group">
    <li class="list-group-item">
        <strong>Kategori Adı:</strong> @Model.Name
    </li>
    <li class="list-group-item">
        <strong>Kurs Sayısı:</strong> @Model.CourseCount
    </li>
</ul>

@if (Model.CourseCount > 0)
{
    <div class="alert alert-warning mt-3">
        Bu kategoriye ait @Model.CourseCount kurs bulunmaktadır. Kategoriyi silmek için önce bu kursları başka bir kategoriye taşımanız gerekmektedir.
    </div>
}
else
{
    <p class="mt-3">
        Kategoriyi silmek istediğinizden emin misiniz?
    </p>
    <form asp-action="Delete" method="post" class="mt-3">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">Sil</button>
    </form>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Geri Dön</a>