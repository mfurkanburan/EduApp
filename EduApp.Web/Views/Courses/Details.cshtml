@model CourseDetailsViewModel

@{
    ViewData["Title"] = "Kurs Detayları";
}

<h1>@Model.Title</h1>
<ul>
    <li><strong>Açıklama:</strong> @Model.Description</li>
    <li><strong>Oluşturulma Tarihi:</strong> @Model.CreatedAt</li>
    <li><strong>Kategori:</strong> @Model.CategoryName</li>
</ul>

<a asp-action="Index" class="btn btn-secondary">Geri Dön</a>