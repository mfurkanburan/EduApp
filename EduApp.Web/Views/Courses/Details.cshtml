@model CourseDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["EnrollmentSuccess"] is string enrollmentMessage)
{
    string messageType = TempData["EnrollmentSuccessType"] as string ?? "success";
    string messageClass = messageType == "Success"
        ? "border-l-emerald-500 text-emerald-500"
        : "border-l-rose-500 text-rose-500";

    <div class="p-4 text-sm rounded-2xl bg-white border-2 border-gray-200 border-l-4 @messageClass font-semibold">
        @enrollmentMessage
    </div>
}


<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
    </div>

    <div class="relative z-10 space-y-3">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <div class="inline-flex items-center space-x-2 bg-indigo-50 border border-indigo-200 text-indigo-500 text-xs font-bold px-3 py-1 rounded-full shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"></path>
                    </svg>

                    <span><strong>Kategori:</strong> @Model.CategoryName</span>
                </div>
                @switch (Model.Level)
                {
                    case CourseLevel.Beginner:
                        <div class="bg-gray-100 text-gray-600/90 border border-gray-300 text-[11px] font-bold px-3 py-1 rounded-full shadow-xs"><strong>Seviye:</strong> @CourseLevel.Beginner.ToDisplayName()</div>
                        break;
                    case CourseLevel.Intermediate:
                        <div class="bg-amber-100 text-amber-600/90 border border-amber-300 text-[11px] font-bold px-3 py-1 rounded-full shadow-xs"><strong>Seviye:</strong> @CourseLevel.Intermediate.ToDisplayName()</div>
                        break;
                    case CourseLevel.Advanced:
                        <div class="bg-rose-100 text-rose-600/90 border border-rose-300 text-[11px] font-bold px-3 py-1 rounded-full shadow-xs"><strong>Seviye:</strong> @CourseLevel.Advanced.ToDisplayName()</div>
                        break;
                }
            </div>

            <div class="flex items-center space-x-2">
                @if (Model.CanManageCourse)
                {
                    <a asp-controller="Courses" asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center space-x-2 bg-orange-50 border border-orange-200 text-orange-500 text-xs font-bold px-3 py-1 rounded-full hover:bg-orange-100 hover:text-orange-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path>
                        </svg>

                        <span>Kursu Düzenle</span>
                    </a>
                    <a asp-controller="Courses" asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center space-x-2 bg-rose-50 border border-rose-200 text-rose-500 text-xs font-bold px-3 py-1 rounded-full hover:bg-rose-100 hover:text-rose-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 1-7.5 0"></path>
                        </svg>

                        <span>Kursu Sil</span>
                    </a>
                }
                <a asp-controller="Courses" asp-action="Index" class="inline-flex items-center space-x-2 bg-gray-50 border border-gray-200 text-gray-500 text-xs font-bold px-3 py-1 rounded-full hover:bg-gray-100 hover:text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15m0 0l6.75 6.75M4.5 12l6.75-6.75"></path>
                    </svg>

                    <span>Geri Dön</span>
                </a>
            </div>
        </div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight leading-snug">
            @Model.Title
        </h1>
        <div class="flex justify-between">
            <p class="text-sm leading-relaxed text-gray-500 max-w-4xl">
                @Model.Description
            </p>
            @if (Model.CanEnroll) {
                <form asp-controller="Enrollments" asp-action="Enroll" method="post">
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    <button type="submit" class="h-12 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">Kursa Kaydol</button>
                </form>
            }
            else if (Model.IsEnrolled)
            {
                <span class="h-12 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-not-allowed border-indigo-600 font-bold text-white rounded-xl select-none opacity-70">Kursa Kayıtlısınız</span>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" class="h-12 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">Kursa Kaydol</a>
            }
        </div>
    </div>
</section>

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
    </div>

    <div class="relative z-10 space-y-5">
        <div class="flex items-center space-x-4 pb-4 border-b-2 border-gray-200">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
            </div>
            <div>
                <h2 class="text-base font-bold text-gray-900">Kurs Gereksinimleri</h2>
                <p class="text-xs text-gray-500">Kursa başlamadan önce sahip olunması gereken bilgiler ve beceriler.</p>
            </div>
        </div>
        @if (Model.Requirements.Count == 0)
        {
            <div class="flex items-center gap-3 text-sm text-gray-600">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </span>
                <span class="leading-relaxed">Bu kurs için herhangi bir gereksinim belirtilmemiştir.</span>
            </div>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var requirement in Model.Requirements)
                {
                    <li class="flex items-center gap-3 text-sm text-gray-600">
                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                            </svg>
                        </span>
                        <span class="leading-relaxed">@requirement.Text</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<hr class="border-2 border-gray-200">

<section>
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-gray-900">Kurs İçeriği</h2>
            <p class="text-sm text-gray-500">Kursun içerdiği bölümler ve dersler.</p>
        </div>

        @if (Model.CanManageCourse)
        {
            <div class="flex items-center">
                <a asp-controller="CourseSections" asp-action="Create" asp-route-courseId="@Model.Id" class="h-11 px-4 flex items-center justify-center bg-white border-2 border-b-4 text-sm active:border-b-2 border-gray-200 font-bold text-gray-500 rounded-xl shrink-0">
                    Yeni Bölüm Ekle
                </a>
            </div>
        }
    </div>
</section>

<section class="grid grid-cols-6 gap-4">
    <div class="col-span-4">
        <div class="bg-white border-2 border-gray-200 rounded-2xl">
            @if (Model.SelectedLesson is null)
            {
                <div class="flex flex-col items-center justify-center space-y-4 text-gray-500 p-8">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <p class="text-gray-500 text-sm">Henüz ders bulunmamaktadır.</p>
                </div>
            }
            else if (!Model.CanAccessCourseContent)
            {
                <div class="flex flex-col items-center justify-center space-y-4 text-gray-500 p-8">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <p class="text-gray-500 text-sm">Ders içeriğini görmek için giriş yapmalısınız.</p>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" class="h-12 px-16 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">Giriş Yap</a>
                    }
                    else if (Model.CanEnroll)
                    {
                        <p>Ders içeriğini görmek için kursa kayıt olmalısınız.</p>
                    }
                    else
                    {
                        <p class="text-gray-500 text-sm">Ders içeriğine erişim izniniz yok.</p>
                    }
                </div>
            }
            else
            {
                <div class="border-b-2 border-gray-200 px-6 py-5">
                    <div class="flex items-center justify-between">
                        <div class="space-y-2">
                            <p class="text-xs font-bold uppercase tracking-wide text-indigo-500">@Model.SelectedLesson.SectionTitle</p>
                            <h3 class="text-xl font-bold text-gray-900">@Model.SelectedLesson.Title</h3>
                        </div>

                        @if (Model.CanManageCourse)
                        {
                            <div class="flex items-center space-x-2">
                                <a asp-controller="Lessons" asp-action="Edit" asp-route-id="@Model.SelectedLesson.Id" class="inline-flex items-center space-x-2 bg-orange-50 border border-orange-200 text-orange-500 text-xs font-bold px-3 py-1 rounded-full hover:bg-orange-100 hover:text-orange-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path>
                                    </svg>

                                    <span>Düzenle</span>
                                </a>
                                <a asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.SelectedLesson.Id" class="inline-flex items-center space-x-2 bg-rose-50 border border-rose-200 text-rose-500 text-xs font-bold px-3 py-1 rounded-full hover:bg-rose-100 hover:text-rose-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 1-7.5 0"></path>
                                    </svg>

                                    <span>Sil</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="p-6">
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedLesson.Content))
                    {
                        <div class="whitespace-pre-line text-sm leading-7 text-gray-600">@Model.SelectedLesson.Content</div>

                        @if (!string.IsNullOrWhiteSpace(Model.SelectedLesson.MaterialFilePath))
                        {
                            <div class="mt-6 pt-6 flex items-center justify-between border-t-2 border-gray-200">
                                <div>
                                    <h4 class="text-sm font-bold text-gray-900">Ders Materyali</h4>

                                    <p class="mt-1 text-xs text-gray-500">
                                        Bu derse ait materyali yeni sekmekede görüntüleyebilirsiniz.
                                    </p>
                                </div>

                                <a href="@Model.SelectedLesson.MaterialFilePath"
                                    target="_blank"
                                    rel="noopener"
                                    class="h-10 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-xs active:border-b-2 border-indigo-600 font-bold text-white rounded-xl shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3 mr-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
                                    </svg>
                                    <span>Materyali Aç</span>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-gray-500 text-sm text-center">Bu ders için henüz içerik eklenmemiştir.</p>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-span-2">
        <div class="bg-white border-2 border-gray-200 rounded-2xl overflow-hidden sticky top-6">
            <div class="border-b-2 border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-base font-bold text-gray-900">Bölümler ve Dersler</h3>
                    <p class="text-xs text-gray-500">@Model.Sections.Count bölüm</p>
                </div>
            </div>

            @if (Model.Sections.Count == 0)
            {
                <div class="flex flex-col items-center justify-center space-y-4 text-gray-500 p-8">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <p class="text-gray-500 text-sm">Henüz bölüm bulunmamaktadır.</p>
                </div>
            }
            else
            {
                <div class="hs-accordion-group divide-y-2 divide-gray-200" data-hs-accordion-always-open>
                    @foreach (var section in Model.Sections)
                    {
                        string accordionId = $"course-section-{section.Id}";
                        string contentId = $"course-section-content-{section.Id}";
                        string accordionClass = section.ContainsSelectedLesson
                            ? "hs-accordion active"
                            : "hs-accordion";
                        string contentClass = section.ContainsSelectedLesson
                            ? "hs-accordion-content w-full overflow-hidden border-t-2 border-gray-200 transition-[height] duration-300"
                            : "hs-accordion-content hidden w-full overflow-hidden border-t-2 border-gray-200 transition-[height] duration-300";

                        <div class="@accordionClass group" id="@accordionId">
                            <div class="flex">
                                <button type="button" class="hs-accordion-toggle flex w-full items-center justify-between gap-3 px-6 py-4 text-start hover:bg-gray-50 cursor-pointer">
                                    <span class="min-w-0">
                                        <span class="block text-xs font-bold uppercase tracking-wide text-indigo-500">
                                            Bölüm @(section.Order): <span class="text-gray-900">@(section.Title)</span>
                                        </span>
                                        <span class="mt-1 block text-xs text-gray-500">
                                            @(section.Lessons.Count) ders
                                        </span>
                                    </span>

                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                        class="size-4 shrink-0 text-gray-400 transition-transform duration-300 group-hs-accordion-outside-active:rotate-180">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
                                    </svg>
                                </button>

                                @if (Model.CanManageCourse)
                                {
                                    <div class="flex flex-col self-stretch">
                                        <a asp-controller="CourseSections" asp-action="Edit" asp-route-id="@(section.Id)" title="Bölümü Düzenle" class="flex flex-1 items-center space-x-2 bg-orange-50 text-orange-500 text-xs font-bold px-3 py-1 hover:bg-orange-100 hover:text-orange-600">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path>
                                            </svg>
                                        </a>

                                        <a asp-controller="CourseSections" asp-action="Delete" asp-route-id="@(section.Id)" title="Bölümü Sil" class="flex flex-1 items-center space-x-2 bg-rose-50 text-rose-500 text-xs font-bold px-3 py-1 hover:bg-rose-100 hover:text-rose-600">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 1-7.5 0"></path>
                                            </svg>
                                        </a>

                                        <a asp-controller="Lessons" asp-action="Create" asp-route-sectionId="@(section.Id)" title="Ders Ekle" class="flex flex-1 items-center space-x-2 bg-indigo-50 text-indigo-500 text-xs font-bold px-3 py-1 hover:bg-indigo-100 hover:text-indigo-600">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                                            </svg>
                                        </a>
                                    </div>
                                }
                            </div>

                            <div id="@contentId" class="@contentClass" role="region" aria-labelledby="@accordionId">
                                @if (section.Lessons.Count == 0)
                                {
                                    <div class="flex flex-col items-center justify-center space-y-4 text-gray-500 p-8">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                                        </svg>
                                        <p class="text-gray-500 text-sm">Henüz ders bulunmamaktadır.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="py-2">
                                        @foreach (var lesson in section.Lessons)
                                        {
                                            string lessonLinkClass = lesson.IsSelected
                                                ? "flex items-center gap-3 border-l-4 border-indigo-500 bg-indigo-50 px-6 py-3 text-indigo-500"
                                                : "flex items-center gap-3 border-l-4 border-transparent px-6 py-3 text-gray-500 hover:bg-gray-50 hover:text-indigo-500";

                                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id" asp-route-lessonId="@lesson.Id" class="@lessonLinkClass">
                                                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-white text-[11px] font-bold shadow">
                                                    @lesson.Order
                                                </span>
                                                <span class="min-w-0 flex-1 truncate text-xs font-semibold">
                                                    @lesson.Title
                                                </span>
                                                @if (lesson.IsSelected)
                                                {
                                                    <span class="size-2 shrink-0 rounded-full bg-indigo-500"></span>
                                                }
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>