@model CourseDetailsViewModel

@{
    ViewData["Title"] = "Kurs Detayları";
}

<h1>@Model.Title</h1>
<ul>
    <li><strong>Açıklama:</strong> @Model.Description</li>
    <li><strong>Oluşturulma Tarihi:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</li>
    <li><strong>Kategori:</strong> @Model.CategoryName</li>
</ul>

<hr />

@if (Model.Sections.Count == 0)
{
    <p>Bu kurs için henüz bölüm eklenmemiştir.</p>
}
else
{
    <div>
        @foreach (var section in Model.Sections)
        {
            <h2 class="h4">@(section.Order). @(section.Title)</h2>
            <div>
                <a asp-action="Edit" asp-controller="CourseSections" asp-route-id="@(section.Id)">Düzenle</a>
                <a asp-action="Delete" asp-controller="CourseSections" asp-route-id="@(section.Id)">Sil</a>
                <a asp-action="Create" asp-controller="Lessons" asp-route-sectionId="@(section.Id)">Yeni Ders Ekle</a>
            </div>
            <ul>
                @if (section.Lessons.Count == 0)
                {
                    <li>Bu bölüm için henüz ders eklenmemiştir.</li>
                }
                else
                {
                    @foreach (var lesson in section.Lessons)
                    {
                        <li>
                            <h4>@lesson.Order. @lesson.Title</h4>
                        </li>

                        <p>
                            @lesson.Content
                        </p>

                        @if (!string.IsNullOrWhiteSpace(lesson.MaterialFilePath))
                        {
                            <a href="@Url.Content(lesson.MaterialFilePath)" target="_blank" class="btn btn-info">Materyali Aç</a>
                        }

                        <a asp-action="Edit" asp-controller="Lessons" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary">Dersi Düzenle</a>
                        <a asp-action="Delete" asp-controller="Lessons" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-danger">Dersi Sil</a>
                    }
                }
            </ul>
        }
    </div>
}

<a asp-action="Create" asp-controller="CourseSections" asp-route-courseId="@Model.Id" class="btn btn-primary">Yeni Bölüm Ekle</a>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>

<a asp-action="Index" class="btn btn-secondary">Geri Dön</a>