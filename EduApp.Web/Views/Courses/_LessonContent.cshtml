@model CourseDetailsViewModel

<div class="bg-white border-2 border-gray-200 rounded-2xl overflow-hidden">
    @if (Model.SelectedLesson is null)
    {
        <div class="flex flex-col items-center justify-center text-center space-y-3 p-14">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
            <h3 class="text-base font-extrabold text-gray-900">Henüz ders bulunmamaktadır</h3>
            <p class="text-xs text-gray-500 max-w-sm">Bu kursa henüz ders eklenmemiştir. İçerikler eklendiğinde burada görüntülenecektir.</p>
        </div>
    }
    else if (!Model.CanAccessCourseContent)
    {
        <div class="flex flex-col items-center justify-center text-center space-y-3 p-14">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <h3 class="text-base font-extrabold text-gray-900">Ders İçeriği Kilitli</h3>
                <p class="text-xs text-gray-500 max-w-sm">Ders içeriğini ve materyallerini görüntülemek için giriş yapmanız gerekmektedir.</p>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" class="mt-2 h-11 px-8 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
                    Giriş Yap
                </a>
            }
            else if (Model.CanEnroll)
            {
                <h3 class="text-base font-extrabold text-gray-900">Kursa Kayıt Gerekli</h3>
                <p class="text-xs text-gray-500 max-w-sm">Bu dersin içeriğine ve materyallerine erişmek için kursa kaydolun.</p>
                <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="mt-2">
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <button type="submit" class="h-11 px-8 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl cursor-pointer">
                        Kursa Kaydol
                    </button>
                </form>
            }
            else
            {
                <h3 class="text-base font-extrabold text-gray-900">Erişim İzni Yok</h3>
                <p class="text-xs text-gray-500 max-w-sm">Bu ders içeriğine erişim izniniz bulunmamaktadır.</p>
            }
        </div>
    }
    else
    {
        <div class="border-b-2 border-gray-200 px-6 py-5">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-1 min-w-0">
                    <p class="text-xs font-bold uppercase tracking-wide text-indigo-500">@Model.SelectedLesson.SectionTitle</p>
                    <h3 class="text-xl font-extrabold text-gray-900">@Model.SelectedLesson.Title</h3>
                </div>

                <div class="flex items-center space-x-2 shrink-0">
                    @if (Model.CanManageCourse)
                    {
                        <a asp-controller="Lessons" asp-action="Edit" asp-route-id="@Model.SelectedLesson.Id" class="inline-flex items-center space-x-1.5 bg-orange-50 border border-orange-200 text-orange-500 text-xs font-bold px-3 py-1.5 rounded-full hover:bg-orange-100 hover:text-orange-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path>
                            </svg>
                            <span>Düzenle</span>
                        </a>
                        <a asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.SelectedLesson.Id" class="inline-flex items-center space-x-1.5 bg-rose-50 border border-rose-200 text-rose-500 text-xs font-bold px-3 py-1.5 rounded-full hover:bg-rose-100 hover:text-rose-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 1-7.5 0"></path>
                            </svg>
                            <span>Sil</span>
                        </a>
                    }

                    @if (Model.IsEnrolled)
                    {
                        @if (!Model.IsSelectedLessonCompleted)
                        {
                            <span class="inline-flex items-center space-x-1.5 bg-gray-50 border border-gray-200 text-gray-500 text-xs font-bold px-3 py-1.5 rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                                </svg>
                                <span>Devam Ediyor</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center space-x-1.5 bg-emerald-50 border border-emerald-200 text-emerald-600 text-xs font-bold px-3 py-1.5 rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                                </svg>
                                <span>Tamamlandı</span>
                            </span>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="p-6 space-y-6">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLesson.Content))
            {
                <div class="whitespace-pre-line text-sm leading-7 text-gray-600">@Model.SelectedLesson.Content</div>
            }
            else
            {
                <p class="text-gray-500 text-sm text-center py-6">Bu ders için henüz içerik eklenmemiştir.</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SelectedLesson.MaterialFilePath))
            {
                <div class="flex items-center justify-between rounded-2xl border-2 border-gray-200 bg-gray-50 p-4">
                    <div class="flex items-center space-x-3">
                        <div class="size-10 rounded-xl bg-white border border-gray-200 text-indigo-500 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-gray-900">Ders Materyali</h4>
                            <p class="text-xs text-gray-500">Bu derse ait dosyayı yeni sekmede açabilir veya indirebilirsiniz.</p>
                        </div>
                    </div>

                    <a href="@Model.SelectedLesson.MaterialFilePath"
                       target="_blank"
                       rel="noopener"
                       class="h-10 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
                        </svg>
                        <span>Materyali Aç</span>
                    </a>
                </div>
            }
        </div>

        @if (Model.CanCompleteSelectedLesson && Model.SelectedLesson is not null)
        {
            <form asp-controller="Enrollments" asp-action="CompleteLesson" method="post">
                <input type="hidden" name="lessonId" value="@Model.SelectedLesson.Id" />

                <div class="relative overflow-hidden border-t-2 border-gray-200 bg-gray-50 px-6 py-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute inset-0 h-full w-full text-indigo-100">
                        <defs>
                            <pattern id="lesson-action-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                                <path d="M 24 0 L 0 0 0 24" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                                <circle cx="12" cy="12" r="1.1" fill="currentColor"></circle>
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#lesson-action-grid)"></rect>
                    </svg>

                    <div class="relative z-10 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl border-2 border-indigo-200 bg-white text-indigo-500 shadow-2xs">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-extrabold text-gray-900">Dersi bitirdiniz mi?</p>
                                <p class="text-xs font-medium text-gray-500">İlerlemenizi kaydetmek için dersi tamamlandı olarak işaretleyin.</p>
                            </div>
                        </div>

                        <button type="submit" class="h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-xs cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">
                            Dersi Tamamla
                        </button>
                    </div>
                </div>
            </form>
        }
        else if (Model.IsSelectedLessonCompleted)
        {
            <div class="relative overflow-hidden border-t-2 border-emerald-100 bg-emerald-50 px-6 py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute inset-0 h-full w-full text-emerald-500">
                    <defs>
                        <linearGradient id="lesson-done-bg" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="currentColor" stop-opacity="0.02"></stop>
                            <stop offset="65%" stop-color="currentColor" stop-opacity="0.07"></stop>
                            <stop offset="100%" stop-color="currentColor" stop-opacity="0.14"></stop>
                        </linearGradient>
                        <pattern id="lesson-done-pattern" width="56" height="56" patternUnits="userSpaceOnUse" patternTransform="rotate(-12)">
                            <path d="M8 14 L12 18 L20 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.18"></path>
                            <circle cx="42" cy="24" r="1.3" fill="currentColor" fill-opacity="0.16"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#lesson-done-bg)"></rect>
                    <rect width="100%" height="100%" fill="url(#lesson-done-pattern)"></rect>
                </svg>

                <div class="relative z-10 flex items-center gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-xl border-2 border-emerald-200 bg-white text-emerald-500 shadow-2xs">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-extrabold text-emerald-800">Ders Tamamlandı</p>
                        <p class="text-xs font-medium text-emerald-700">Bu dersi başarıyla bitirdiniz.</p>
                    </div>
                </div>
            </div>
        }
    }
</div>