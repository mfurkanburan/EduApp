@model List<InstructorCourseViewModel>

@{
    ViewData["Title"] = "Eğitmen Paneli";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-8 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="instructor-banner-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#instructor-banner-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-6">
        <div class="flex items-center space-x-5">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Eğitmen Paneli</h1>
                <p class="text-sm font-light text-gray-500 mt-0.5">Oluşturduğunuz kursları, bölümleri, dersleri ve öğrenci sayılarını buradan yönetin.</p>
            </div>
        </div>

        <a asp-controller="Courses" asp-action="Create" class="h-11 px-5 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0">
            Yeni Kurs Ekle
        </a>
    </div>
</section>

<section class="grid grid-cols-3 gap-4">
    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Kurs</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-indigo-500">@Model.Count</p>
    </div>

    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Ders</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-orange-500">@Model.Sum(c => c.LessonCount)</p>
    </div>

    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Kayıtlı Öğrenci</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-emerald-500">@Model.Sum(c => c.StudentCount)</p>
    </div>
</section>

<section>
    @if (Model.Count == 0)
    {
        <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-16 rounded-2xl">
            <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <defs>
                        <pattern id="instructor-empty-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                            <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                            <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" stroke-width="0" fill="url(#instructor-empty-grid)"></rect>
                </svg>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                    </svg>
                </div>
                <h2 class="text-lg font-extrabold text-gray-900">Henüz oluşturduğunuz bir kurs bulunmamaktadır</h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm">
                    İlk kursunuzu oluşturup bölümler ve ders materyalleri ekleyerek öğrencilerinizle paylaşabilirsiniz.
                </p>
                <a asp-controller="Courses" asp-action="Create" class="mt-2 h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
                    İlk Kursu Oluştur
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-3 gap-4">
            @foreach (var course in Model)
            {
                <article class="bg-white border-2 border-gray-200 hover:border-indigo-500 rounded-2xl p-4 flex flex-col group">
                    <div class="relative overflow-hidden rounded-xl h-42 mb-3 bg-gray-100">
                        <img src="@(string.IsNullOrWhiteSpace(course.CoverImagePath)
                                    ? "https://placehold.co/600x400/E1E7FF/4F46E5?text=Kurs+Görseli"
                                    : course.CoverImagePath)"
                             alt="@course.Title"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />

                        <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5">
                            <span class="bg-indigo-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@course.CategoryName</span>
                            @switch (course.Level)
                            {
                                case CourseLevel.Beginner:
                                    <span class="bg-gray-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Beginner.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Intermediate:
                                    <span class="bg-amber-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Intermediate.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Advanced:
                                    <span class="bg-rose-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Advanced.ToDisplayName()</span>
                                    break;
                            }
                        </div>

                        <div class="absolute bottom-2.5 right-2.5 bg-white/90 backdrop-blur-xs text-gray-800 text-[11px] font-semibold px-2 py-0.5 rounded-lg shadow-xs">
                            @course.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="text-lg font-bold leading-tight text-gray-900 group-hover:text-indigo-500 truncate">
                                @course.Title
                            </h3>

                            <div class="mt-3 grid grid-cols-3 gap-2 text-center">
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-gray-900">@course.SectionCount</p>
                                    <p class="text-[11px] text-gray-500">Bölüm</p>
                                </div>
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-gray-900">@course.LessonCount</p>
                                    <p class="text-[11px] text-gray-500">Ders</p>
                                </div>
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-emerald-600">@course.StudentCount</p>
                                    <p class="text-[11px] text-gray-500">Öğrenci</p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-3 border-t border-gray-100">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="h-9 flex items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 text-xs font-bold hover:bg-indigo-500 hover:text-white">
                                İncele
                            </a>
                            <a asp-controller="CourseSections" asp-action="Create" asp-route-courseId="@course.Id" class="h-9 flex items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 text-xs font-bold hover:bg-emerald-500 hover:text-white">
                                + Bölüm Ekle
                            </a>
                            <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id" class="h-9 flex items-center justify-center rounded-xl bg-orange-50 text-orange-600 text-xs font-bold hover:bg-orange-500 hover:text-white">
                                Düzenle
                            </a>
                            <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.Id" class="h-9 flex items-center justify-center rounded-xl bg-rose-50 text-rose-600 text-xs font-bold hover:bg-rose-500 hover:text-white">
                                Sil
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>