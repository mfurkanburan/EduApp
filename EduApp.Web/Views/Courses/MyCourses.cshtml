@model List<InstructorCourseViewModel>

@{
    ViewData["Title"] = "Eğitmen Paneli";
}

<section class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Eğitmen Paneli</h1>
            <p class="text-sm font-light text-gray-500">Oluşturduğunuz kursları, içerikleri ve öğrenci sayılarını buradan yönetin.</p>
        </div>
        <a asp-controller="Courses" asp-action="Create" class="h-11 px-4 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm active:border-b-2 border-indigo-600 font-bold text-white rounded-xl shrink-0">
            Yeni Kurs Ekle
        </a>
    </div>

    <div class="grid grid-cols-3 gap-4">
        <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Kurs</p>
            <p class="mt-1 text-3xl font-extrabold text-indigo-500">@Model.Count</p>
        </div>
        <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Ders</p>
            <p class="mt-1 text-3xl font-extrabold text-orange-500">@Model.Sum(c => c.LessonCount)</p>
        </div>
        <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Toplam Kayıtlı Öğrenci</p>
            <p class="mt-1 text-3xl font-extrabold text-emerald-500">@Model.Sum(c => c.StudentCount)</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-16 rounded-2xl">
            <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <defs>
                        <pattern id="instructor-empty-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                            <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                            <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" stroke-width="0" fill="url(#instructor-empty-grid)"></rect>
                </svg>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-600 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                    </svg>
                </div>
                <h2 class="text-lg font-extrabold text-gray-900">Henüz oluşturduğunuz bir kurs bulunmamaktadır</h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm">
                    İlk kursunuzu oluşturup bölümler ve ders materyalleri ekleyerek öğrencilerinizle paylaşabilirsiniz.
                </p>
                <a asp-controller="Courses" asp-action="Create" class="mt-2 h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">
                    İlk Kursu Oluştur
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 gap-6">
            @foreach (var course in Model)
            {
                <article class="group flex flex-row overflow-hidden rounded-2xl border-2 border-gray-200 bg-white hover:border-indigo-500">
                    <div class="relative w-44 shrink-0 overflow-hidden bg-gray-100">
                        <img src="@(string.IsNullOrWhiteSpace(course.CoverImagePath)
                                    ? "https://placehold.co/600x400/E1E7FF/4F46E5?text=Kurs+Görseli"
                                    : course.CoverImagePath)"
                             alt="@course.Title"
                             class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        <div class="absolute top-2.5 left-2.5 bg-white/90 backdrop-blur-xs text-indigo-500 text-[11px] font-bold px-2 py-0.5 rounded-lg shadow-xs">
                            @course.CategoryName
                        </div>
                    </div>

                    <div class="flex flex-1 flex-col justify-between min-w-0 p-5 space-y-4">
                        <div>
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[11px] font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-lg">
                                    @course.Level.ToDisplayName()
                                </span>
                                <span class="text-xs text-gray-400">
                                    @course.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </span>
                            </div>
                            <h3 class="mt-2 text-lg font-bold text-gray-900 group-hover:text-indigo-500 truncate">
                                @course.Title
                            </h3>
                            <div class="mt-3 grid grid-cols-3 gap-2 text-center">
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-gray-900">@course.SectionCount</p>
                                    <p class="text-[11px] text-gray-500">Bölüm</p>
                                </div>
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-gray-900">@course.LessonCount</p>
                                    <p class="text-[11px] text-gray-500">Ders</p>
                                </div>
                                <div class="rounded-xl border border-gray-200 bg-gray-50 py-2">
                                    <p class="text-sm font-extrabold text-emerald-600">@course.StudentCount</p>
                                    <p class="text-[11px] text-gray-500">Öğrenci</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="px-3 py-1.5 rounded-xl bg-indigo-50 text-indigo-600 text-xs font-bold hover:bg-indigo-500 hover:text-white">
                                İncele
                            </a>
                            <a asp-controller="CourseSections" asp-action="Create" asp-route-courseId="@course.Id" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-600 text-xs font-bold hover:bg-emerald-500 hover:text-white">
                                + Bölüm Ekle
                            </a>
                            <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id" class="px-3 py-1.5 rounded-xl bg-orange-50 text-orange-600 text-xs font-bold hover:bg-orange-500 hover:text-white">
                                Düzenle
                            </a>
                            <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.Id" class="px-3 py-1.5 rounded-xl bg-rose-50 text-rose-600 text-xs font-bold hover:bg-rose-500 hover:text-white">
                                Sil
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>