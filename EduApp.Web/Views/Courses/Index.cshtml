@model List<Course>

@{
    ViewData["Title"] = "Kurslar";
}

<h1>Kurslar</h1>
<p>Kurslar aşağıda listelenmektedir.</p>

@foreach (var course in Model)
{
    <div>
        <h2>@course.Title</h2>
        <p>@course.Description</p>
        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-secondary">Düzenle</a>
        <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary">Detay</a>
    </div>
}

<a asp-action="Create" class="btn btn-primary mt-3">Yeni Kurs Ekle</a>