@model CourseListViewModel

@{
    ViewData["Title"] = "Kurslar";
}

<h1>Kurslar</h1>
<p>Kurslar aşağıda listelenmektedir.</p>

<form method="get" asp-action="Index">
    <div class="input-group mb-3">
        <input type="text" name="search" class="form-control" placeholder="Kurs Ara..." value="@Model.Search" />
        <button class="btn btn-outline-secondary" type="submit">Ara</button>
    </div>
</form>

@foreach (var course in Model.Courses)
{
    <div>
        <h2>@course.Title</h2>
        <p>@course.Description</p>
        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-secondary">Düzenle</a>
        <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger">Sil</a>
        <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary">Detay</a>
    </div>
}

<a asp-action="Create" class="btn btn-primary mt-3">Yeni Kurs Ekle</a>