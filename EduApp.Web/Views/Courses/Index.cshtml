@model CourseListViewModel

@{
    ViewData["Title"] = "Kurslar";
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.Level.HasValue;
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-8 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="courses-banner-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#courses-banner-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-6">
        <div class="flex items-center space-x-5">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Kurs Kataloğu</h1>
                <p class="text-sm font-light text-gray-500 mt-0.5">Kendinize uygun kursları arayın, kategori ve seviyeye göre filtreleyip keşfedin.</p>
            </div>
        </div>

        @if (User.IsInRole(ApplicationRoles.Instructor))
        {
            <a asp-controller="Courses" asp-action="Create" class="h-11 px-5 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0">
                Yeni Kurs Ekle
            </a>
        }
    </div>
</section>

<section class="bg-white border-2 border-gray-200 p-5 rounded-2xl space-y-4">
    <form method="get" asp-action="Index">
        @if (Model.Level.HasValue)
        {
            <input type="hidden" name="level" value="@Model.Level.Value" />
        }

        <div class="flex items-center gap-3">
            <input type="text"
                   name="search"
                   class="h-12 w-full px-4 bg-gray-50 rounded-xl border-2 border-gray-200 text-sm text-gray-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                   placeholder="Kurs adı, kategori veya eğitmen adına göre arayın..."
                   value="@Model.Search" />

            <select name="categoryId"
                    onchange="this.form.submit()"
                    class="h-12 w-64 px-4 bg-gray-50 rounded-xl border-2 border-gray-200 text-sm text-gray-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent shrink-0">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
            </select>

            <button type="submit"
                    class="h-12 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0 cursor-pointer">
                Ara
            </button>
        </div>
    </form>

    <div class="flex items-center justify-between pt-4 border-t-2 border-gray-100">
        <div class="flex items-center space-x-2">
            <span class="text-xs font-bold uppercase tracking-wide text-gray-400 mr-1">Seviye:</span>

            <a asp-controller="Courses" asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               class="px-3.5 py-1.5 rounded-full text-xs font-bold @(Model.Level is null ? "border-2 border-indigo-500 text-indigo-500 bg-indigo-50" : "bg-gray-50 border-2 border-gray-200 text-gray-500 hover:text-indigo-500")">
                Tümü
            </a>
            <a asp-controller="Courses" asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-level="@CourseLevel.Beginner"
               class="px-3.5 py-1.5 rounded-full text-xs font-bold @(Model.Level == CourseLevel.Beginner ? "border-2 border-indigo-500 text-indigo-500 bg-indigo-50" : "bg-gray-50 border-2 border-gray-200 text-gray-500 hover:text-indigo-500")">
                Başlangıç
            </a>
            <a asp-controller="Courses" asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-level="@CourseLevel.Intermediate"
               class="px-3.5 py-1.5 rounded-full text-xs font-bold @(Model.Level == CourseLevel.Intermediate ? "border-2 border-indigo-500 text-indigo-500 bg-indigo-50" : "bg-gray-50 border-2 border-gray-200 text-gray-500 hover:text-indigo-500")">
                Orta
            </a>
            <a asp-controller="Courses" asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-level="@CourseLevel.Advanced"
               class="px-3.5 py-1.5 rounded-full text-xs font-bold @(Model.Level == CourseLevel.Advanced ? "border-2 border-indigo-500 text-indigo-500 bg-indigo-50" : "bg-gray-50 border-2 border-gray-200 text-gray-500 hover:text-indigo-500")">
                İleri
            </a>
        </div>

        @if (hasActiveFilter)
        {
            <a asp-controller="Courses" asp-action="Index" class="px-3.5 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-rose-500 hover:bg-rose-100 text-xs font-bold">
                Filtreleri Temizle
            </a>
        }
        else
        {
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-bold text-gray-500">
                @Model.Courses.Count kurs listeleniyor
            </span>
        }
    </div>
</section>

<section>
    @if (Model.Courses.Count == 0)
    {
        <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-16 rounded-2xl">
            <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <defs>
                        <pattern id="courses-empty-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                            <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                            <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" stroke-width="0" fill="url(#courses-empty-grid)"></rect>
                </svg>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                </div>
                <h2 class="text-lg font-extrabold text-gray-900">Aramanızla eşleşen kurs bulunamadı</h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm">
                    Farklı bir anahtar kelime deneyebilir veya aktif filtreleri temizleyerek tüm kursları görebilirsiniz.
                </p>
                @if (hasActiveFilter)
                {
                    <a asp-controller="Courses" asp-action="Index" class="mt-2 h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
                        Filtreleri Temizle
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-3 gap-4">
            @foreach (var course in Model.Courses)
            {
                <article class="bg-white border-2 border-gray-200 hover:border-indigo-500 rounded-2xl p-4 flex flex-col group">
                    <div class="relative overflow-hidden rounded-xl h-42 mb-3 bg-gray-100">
                        <img src="@(string.IsNullOrWhiteSpace(course.CoverImagePath)
                                    ? "https://placehold.co/600x400/E1E7FF/4F46E5?text=Kurs+Görseli"
                                    : course.CoverImagePath)"
                             alt="@course.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5">
                            <span class="bg-indigo-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@course.CategoryName</span>
                            @switch (course.Level)
                            {
                                case CourseLevel.Beginner:
                                    <span class="bg-gray-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Beginner.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Intermediate:
                                    <span class="bg-amber-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Intermediate.ToDisplayName()</span>
                                    break;
                                case CourseLevel.Advanced:
                                    <span class="bg-rose-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">@CourseLevel.Advanced.ToDisplayName()</span>
                                    break;
                            }
                        </div>
                        <div class="absolute bottom-2.5 right-2.5 bg-white/90 backdrop-blur-xs text-gray-800 text-[11px] font-semibold px-2 py-0.5 rounded-lg shadow-xs">
                            @course.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-bold leading-tight text-gray-900 group-hover:text-indigo-500">@course.Name</div>
                            <p class="text-xs font-light text-gray-500 mt-1.5 line-clamp-3">
                                @(course.Description.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-gray-100 flex items-center justify-between">
                            <div class="flex items-center space-x-2 min-w-0">
                                @if (!string.IsNullOrWhiteSpace(course.InstructorProfileImagePath))
                                {
                                    <img src="@course.InstructorProfileImagePath" alt="@course.InstructorName" class="w-6 h-6 rounded-full object-cover shrink-0" />
                                }
                                else
                                {
                                    <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 text-[10px] font-bold flex items-center justify-center select-none shrink-0">
                                        @(string.IsNullOrWhiteSpace(course.InstructorName) ? "E" : course.InstructorName[0].ToString().ToUpper())
                                    </div>
                                }
                                <span class="text-xs font-medium text-gray-700 truncate">@course.InstructorName</span>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="flex items-center space-x-1 px-3.5 py-2 rounded-xl bg-indigo-50 text-indigo-500 text-xs font-bold hover:bg-indigo-500 hover:text-white shrink-0">
                                <span>İncele</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (Model.TotalPages > 1)
{
    <section class="flex items-center justify-center space-x-1.5">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-controller="Courses" asp-action="Index"
               asp-route-page="@i"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-level="@Model.Level"
               class="border-2 border-b-4 text-sm font-bold h-10 w-10 flex items-center justify-center rounded-xl @(i == Model.CurrentPage ? "bg-indigo-50 border-indigo-500 text-indigo-500" : "bg-white border-gray-200 text-gray-500")">
                @i
            </a>
        }
    </section>
}