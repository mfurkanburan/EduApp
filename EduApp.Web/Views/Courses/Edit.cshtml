@model EditCourseViewModel

@{
    ViewData["Title"] = "Kurs Düzenle";
}

<section class="flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold">Kurs Düzenle</h1>
        <p class="text-sm font-light text-gray-500">Kurs bilgilerini, gereksinimleri ve kapak görselini güncelleyin.</p>
    </div>
    <div class="flex items-center space-x-2">
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id" class="h-10 px-4 flex items-center space-x-2 bg-indigo-100 text-indigo-500 text-xs font-bold hover:bg-indigo-500 hover:text-white rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <span>Kursa Dön</span>
        </a>

        <a asp-controller="Courses" asp-action="Index" class="h-10 px-4 flex items-center space-x-2 bg-white hover:bg-gray-50 border-2 border-gray-200 text-gray-500 text-xs font-bold rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4.5 stroke-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 9-3 3m0 0 3 3m-3-3h7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>Geri Dön</span>
        </a>
    </div>
</section>

<section>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingCoverImagePath" />

        <div class="lg:col-span-2 space-y-6">
            <!-- Course Details -->
            <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl">
                <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                    <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                        <defs>
                            <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                                <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                                <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
                    </svg>
                </div>

                <div class="relative z-10 space-y-5">
                    <div class="flex items-center space-x-4 pb-4 border-b-2 border-gray-200">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-gray-900">Temel Kurs Bilgileri</h2>
                            <p class="text-xs text-gray-500">Öğrencilerin kursu tanımasını sağlayacak ana detaylar.</p>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Title" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Başlık:</label>
                        <input asp-for="Title" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                        <span asp-validation-for="Title" class="text-xs text-rose-500"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Description" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Açıklama:</label>
                        <textarea asp-for="Description" class="h-32 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"></textarea>
                        <span asp-validation-for="Description" class="text-xs text-rose-500"></span>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label asp-for="CategoryId" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Kategori:</label>
                            <select asp-for="CategoryId" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <option value="0">Kategori Seçiniz</option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-xs text-rose-500"></span>
                        </div>
                        <div class="space-y-1.5">
                            <label asp-for="Level" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Seviye:</label>
                            <select asp-for="Level" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <option value="">Seviye Seçiniz</option>
                                <option value="1">Başlangıç</option>
                                <option value="2">Orta</option>
                                <option value="3">İleri</option>
                            </select>
                            <span asp-validation-for="Level" class="text-xs text-rose-500"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course Requirements -->
            <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl">
                <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                    <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                        <defs>
                            <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                                <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                                <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
                    </svg>
                </div>

                <div class="relative z-10 space-y-5">
                    <div class="flex items-center space-x-4 pb-4 border-b-2 border-gray-200">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-gray-900">Kurs Gereksinimleri</h2>
                            <p class="text-xs text-gray-500">Öğrencilerin derse başlamadan önce bilmesi veya sahip olması gerekenler.</p>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="RequirementsText" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Gereksinimler:</label>
                        <textarea asp-for="RequirementsText" class="h-32 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"></textarea>
                        <span asp-validation-for="RequirementsText" class="text-xs text-rose-500"></span>

                        <div class="mt-4 flex items-center space-x-2 bg-indigo-50 border border-indigo-200 text-indigo-500 text-xs font-medium rounded-xl px-3.5 py-2.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"></path>
                            </svg>
                            <span>Her gereksinimi yeni bir satıra yazarak ekleyiniz.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <!-- Course Cover Image -->
            <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl">
                <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                    <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                        <defs>
                            <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                                <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                                <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
                    </svg>
                </div>

                <div class="relative z-10 space-y-5">
                    <div class="flex items-center space-x-4 pb-4 border-b-2 border-gray-200">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-gray-900">Kapak Resmi</h2>
                            <p class="text-xs text-gray-500">Kurs listesinde görünecek kapak resmi.</p>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingCoverImagePath))
                    {
                        <div class="space-y-3">
                            <span class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Mevcut Kapak Resmi:</span>
                            <div class="relative overflow-hidden rounded-xl border-2 border-gray-200 bg-gray-200 aspect-video">
                                <img src="@Url.Content("~/" + Model.ExistingCoverImagePath.TrimStart('/'))" alt="@Model.Title" class="w-full h-full object-cover" />
                            </div>
                            <label class="flex items-center space-x-3 rounded-xl p-3 bg-rose-50 text-rose-500 text-xs font-bold hover:bg-rose-100 border border-rose-200 cursor-pointer">
                                <input asp-for="RemoveExistingCoverImage" class="w-4 h-4 rounded text-rose-500 focus:ring-1 focus:ring-rose-500" />
                                <span>Mevcut kapak resmini kaldır</span>
                            </label>
                        </div>
                    }

                    <div class="space-y-2">
                        <label asp-for="CoverImage" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Yeni Kapak Resmi:</label>
                        <input asp-for="CoverImage" type="file" accept=".jpg,.jpeg,.png,.webp" class="cursor-pointer block w-full bg-white border-2 border-gray-200 rounded-lg text-xs text-gray-500 placeholder:text-gray-400 focus:outline-hidden focus:border-indigo-500 focus:ring-0.5 focus:ring-indigo-500
                                file:bg-indigo-50
                                file:text-indigo-500
                                file:font-bold
                                file:uppercase
                                file:cursor-pointer
                                file:me-4
                                file:py-3 file:px-4">
                        <span asp-validation-for="CoverImage" class="text-xs text-rose-500 block"></span>

                        <p class="text-xs text-gray-500">
                            Yeni görsel yüklediğinizde mevcut kapak resmi kaldırılacaktır. Yüklenen resmin boyutu 5 MB'yi geçmemelidir.
                        </p>
                    </div>
                </div>
            </div>

            <button class="h-12 w-full flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl" type="submit">Kurs Düzenle</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const coverImageInput = document.getElementById('CoverImage');

        coverImageInput.addEventListener('change', function () {
            const file = this.files[0];
            
            if (!file) return;

            const maximumSize = 5 * 1024 * 1024;

            if (file.size > maximumSize) {
                alert('Dosya boyutu 5 MB\'yi geçemez. Lütfen daha küçük bir dosya seçin.');
                this.value = '';
            }
        });
    </script>
}