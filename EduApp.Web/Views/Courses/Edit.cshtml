@model EditCourseViewModel

@{
    ViewData["Title"] = "Kurs Düzenle";
}

<h1>Kurs Düzenle</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingCoverImagePath" />

    <div class="form-group">
        <label asp-for="Title" class="form-label">Başlık:</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="form-label">Açıklama:</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="CategoryId" class="form-label">Kategori:</label>
        <select asp-for="CategoryId" class="form-control">
            <option value="0">Kategori Seçiniz</option>

            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Level" class="form-label">Seviye:</label>
        <select asp-for="Level" class="form-control">
            <option value="">Seviye Seçiniz</option>
            <option value="1">Başlangıç</option>
            <option value="2">Orta</option>
            <option value="3">İleri</option>
        </select>
        <span asp-validation-for="Level" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="RequirementsText" class="form-label">Gereksinimler:</label>
        <textarea asp-for="RequirementsText" class="form-control"></textarea>
        <span asp-validation-for="RequirementsText" class="text-danger"></span>

        <p class="form-text text-muted">
            Her gereksinimi yeni bir satıra yazarak ekleyiniz.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ExistingCoverImagePath))
    {
        <div class="form-group">
            <p class="form-label">Mevcut Kapak Resmi:</p>
            <div>
                <img src="@Url.Content("~/" + Model.ExistingCoverImagePath.TrimStart('/'))" alt="@Model.Title" style="max-width: 280px;" />
            </div>
            <label class="form-check-label mt-2">
                <input asp-for="RemoveExistingCoverImage" /> Mevcut kapak resmini kaldır
            </label>
        </div>
    }

    <div class="form-group">
        <label asp-for="CoverImage" class="form-label">Yeni Kapak Resmi:</label>
        <input asp-for="CoverImage" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control-file" />
        <span asp-validation-for="CoverImage" class="text-danger"></span>

        <p class="form-text text-muted">
            Yeni görsel yüklediğinizde mevcut kapak resmi kaldırılacaktır. Yüklenen görselin boyutu 5 MB'yi geçmemelidir.
        </p>
    </div>

    <button class="btn btn-primary mt-4" type="submit">Kurs Düzenle</button>
</form>

<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary mt-3">Kursa Dön</a>

<a asp-action="Index" class="btn btn-secondary mt-3">Geri Dön</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const coverImageInput = document.getElementById('CoverImage');

        coverImageInput.addEventListener('change', function () {
            const file = this.files[0];
            
            if (!file) return;

            const maximumSize = 5 * 1024 * 1024;

            if (file.size > maximumSize) {
                alert('Dosya boyutu 5 MB\'yi geçemez. Lütfen daha küçük bir dosya seçin.');
                this.value = '';
            }
        });
    </script>
}