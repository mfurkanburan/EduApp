@model List<MyCourseViewModel>

@{
    ViewData["Title"] = "Kurslarım";

    int completedCourseCount = Model.Count(c => c.IsCompleted);
    int inProgressCourseCount = Model.Count - completedCourseCount;
    int totalLessons = Model.Sum(c => c.TotalLessonCount);
    int completedLessons = Model.Sum(c => c.CompletedLessonCount);
    int overallPercentage = totalLessons > 0
        ? (int)Math.Round(completedLessons * 100.0 / totalLessons)
        : 0;
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-8 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="mycourses-banner-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#mycourses-banner-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-6">
        <div class="flex items-center space-x-5">
            <div class="size-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Kurslarım</h1>
                <p class="text-sm font-light text-gray-500 mt-0.5">Kayıtlı olduğunuz kursları ve ders ilerlemelerinizi buradan takip edebilirsiniz.</p>
            </div>
        </div>

        <a asp-controller="Courses" asp-action="Index" class="h-11 px-5 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl shrink-0">
            Kurs Kataloğunu Görüntüle
        </a>
    </div>
</section>

<section class="grid grid-cols-4 gap-4">
    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Kayıtlı Kurs</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-indigo-500">@Model.Count</p>
    </div>

    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Devam Eden</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-orange-500">@inProgressCourseCount</p>
    </div>

    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Tamamlanan</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-emerald-500">@completedCourseCount</p>
    </div>

    <div class="rounded-2xl border-2 border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Genel İlerleme</p>
            <div class="flex size-9 items-center justify-center rounded-xl bg-rose-50 text-rose-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                </svg>
            </div>
        </div>
        <p class="mt-2 text-3xl font-extrabold text-rose-500">%@overallPercentage</p>
    </div>
</section>

<section>
    @if (Model.Count == 0)
    {
        <div class="relative overflow-hidden bg-white border-2 border-gray-200 p-16 rounded-2xl">
            <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
                <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <defs>
                        <pattern id="mycourses-empty-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                            <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                            <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" stroke-width="0" fill="url(#mycourses-empty-grid)"></rect>
                </svg>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"></path>
                    </svg>
                </div>
                <h2 class="text-lg font-extrabold text-gray-900">Henüz kayıtlı olduğunuz kurs bulunmamaktadır</h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm">
                    Kurs kataloğunu inceleyerek ilk kursunuza kaydolun ve öğrenmeye başlayın.
                </p>
                <a asp-controller="Courses" asp-action="Index" class="mt-2 h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
                    Kursları Keşfet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-3 gap-4">
            @foreach (var course in Model)
            {
                <article class="bg-white border-2 border-gray-200 hover:border-indigo-500 rounded-2xl p-4 flex flex-col group">
                    <div class="relative overflow-hidden rounded-xl h-42 mb-3 bg-gray-100">
                        <img src="@(string.IsNullOrWhiteSpace(course.CoverImagePath)
                                    ? "https://placehold.co/600x400/E1E7FF/4F46E5?text=Kurs+Görseli"
                                    : course.CoverImagePath)"
                             alt="@course.Title"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />

                        <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5">
                            <span class="bg-indigo-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">
                                @course.CategoryName
                            </span>
                            @if (course.IsCompleted)
                            {
                                <span class="bg-emerald-600/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">
                                    Tamamlandı
                                </span>
                            }
                            else
                            {
                                <span class="bg-gray-700/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-0.5 rounded-lg shadow-xs">
                                    Devam Ediyor
                                </span>
                            }
                        </div>

                        <div class="absolute bottom-2.5 right-2.5 bg-white/90 backdrop-blur-xs text-gray-800 text-[11px] font-semibold px-2 py-0.5 rounded-lg shadow-xs">
                            @course.EnrolledAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="text-lg font-bold leading-tight text-gray-900 group-hover:text-indigo-500 truncate">
                                @course.Title
                            </h3>
                            <p class="mt-1.5 text-xs text-gray-500 font-medium">
                                Eğitmen: <span class="text-gray-700 font-semibold">@course.InstructorName</span>
                            </p>
                        </div>

                        <div class="space-y-3">
                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-gray-500 font-medium">@course.CompletedLessonCount / @course.TotalLessonCount ders</span>
                                    <span class="font-extrabold @(course.IsCompleted ? "text-emerald-600" : "text-indigo-500")">%@course.ProgressPercentage</span>
                                </div>
                                <div class="h-3 overflow-hidden rounded-full border-2 @(course.IsCompleted ? "border-emerald-100 bg-emerald-50" : "border-indigo-100 bg-indigo-50") p-0.5">
                                    <div class="h-full rounded-full @(course.IsCompleted ? "bg-emerald-500" : "bg-indigo-500")" style="width: @(course.ProgressPercentage)%;"></div>
                                </div>
                            </div>

                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId"
                               class="h-10 w-full flex items-center justify-center space-x-2 rounded-xl text-xs font-bold @(course.IsCompleted ? "bg-emerald-50 text-emerald-600 hover:bg-emerald-500 hover:text-white" : "bg-indigo-50 text-indigo-500 hover:bg-indigo-500 hover:text-white")">
                                <span>@(course.IsCompleted ? "Kursu Tekrar İncele" : "Kursa Devam Et")</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 stroke-2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>