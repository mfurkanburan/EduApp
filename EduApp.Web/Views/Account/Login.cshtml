@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl max-w-2xl mx-auto">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-44 z-0 opacity-60">
        <svg class="h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
        <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 space-y-6">
        <div class="flex flex-col items-center text-center space-y-6">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
            </div>
            <div>
                <h2 class="text-2xl font-extrabold text-gray-900">
                    Giriş Yap
                </h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm mt-2">
                    Kurslarınıza erişmek ve öğrenmeye başlamak için hesabınıza giriş yapın. Hesabınız yoksa, kayıt olarak hemen katılabilirsiniz.
                </p>
            </div>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-6">
            <input asp-for="ReturnUrl" type="hidden" />
            
            <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-500 text-xs font-medium rounded-xl px-3.5 py-2.5"></div>

            <div class="space-y-1.5">
                <label asp-for="Email" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">E-posta</label>
                <input asp-for="Email" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="Email" class="text-xs text-rose-600"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="Password" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Şifre</label>
                <input asp-for="Password" type="password" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="Password" class="text-xs text-rose-600"></span>
            </div>

            <div class="flex items-center space-x-2">
                <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 text-indigo-500 focus:ring-indigo-500 border-2 border-gray-200 rounded" />
                <label asp-for="RememberMe" class="text-sm font-medium text-gray-700">Beni Hatırla</label>
            </div>

            <button type="submit" class="mb-0 h-12 w-full flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">
                Giriş Yap
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}