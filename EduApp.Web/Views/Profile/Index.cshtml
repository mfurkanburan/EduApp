@model ProfileViewModel

@{
    ViewData["Title"] = "Profilim";
}

@if (TempData["ProfileMessage"] is string message)
{
    <div class="p-4 text-sm rounded-2xl bg-white border-2 border-gray-200 border-l-4 border-l-emerald-500 text-emerald-500 font-semibold">
        @message
    </div>
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-8 rounded-2xl">
    <div class="pointer-events-none absolute inset-0 z-0 opacity-60">
        <svg class="absolute inset-0 h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="profile-banner-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#profile-banner-grid)"></rect>
        </svg>
    </div>

    <div class="relative z-10 flex items-center justify-between gap-6">
        <div class="flex items-center space-x-6 min-w-0">
            @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
            {
                <img src="@Model.ProfileImagePath" alt="@Model.FirstName @Model.LastName" class="size-24 rounded-full border-4 border-indigo-100 p-0.5 bg-white object-cover shadow-xs shrink-0" />
            }
            else
            {
                <div class="size-24 rounded-full border-4 border-indigo-100 p-0.5 bg-indigo-50 shadow-xs flex items-center justify-center text-indigo-500 text-3xl font-extrabold shrink-0">
                    @($"{Model.FirstName.FirstOrDefault()}{Model.LastName.FirstOrDefault()}".ToUpper())
                </div>
            }

            <div class="space-y-2 min-w-0">
                <div class="flex items-center space-x-3">
                    <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 truncate">
                        @Model.FirstName @Model.LastName
                    </h1>
                    <span class="inline-flex items-center rounded-full border-2 border-indigo-100 bg-indigo-50 px-3 py-0.5 text-xs font-extrabold uppercase tracking-wide text-indigo-500 shrink-0">
                        @Model.RoleName
                    </span>
                </div>

                <div class="flex items-center space-x-4 text-xs text-gray-500 font-medium">
                    <span class="inline-flex items-center space-x-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                        </svg>
                        <span>@Model.Email</span>
                    </span>
                    <span class="text-gray-300">•</span>
                    <span class="inline-flex items-center space-x-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                        <span>Üyelik Tarihi: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="flex items-center space-x-3 shrink-0">
            <a asp-controller="Profile" asp-action="Edit" class="h-11 px-4 flex items-center space-x-2 bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-white text-xs font-bold rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <span>Profili Düzenle</span>
            </a>

            <a asp-controller="Profile" asp-action="ChangePassword" class="h-11 px-4 flex items-center space-x-2 bg-white border-2 border-b-4 active:border-b-2 border-gray-200 text-gray-500 text-xs font-bold rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                </svg>
                <span>Parolayı Değiştir</span>
            </a>
        </div>
    </div>
</section>

@if (User.IsInRole(ApplicationRoles.Student))
{
    <section class="grid grid-cols-4 gap-4">
        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Kayıtlı Kurs</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                </div>
                <p class="mt-2 text-3xl font-extrabold text-indigo-500">@Model.EnrolledCourseCount</p>
            </div>
            <div class="mt-4 border-t-2 border-gray-200 pt-4">
                <a asp-controller="Enrollments" asp-action="MyCourses" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-500 hover:text-indigo-700">
                    <span>Kurslarımı Görüntüle</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Tamamlanan Kurs</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </div>
                </div>
                <p class="mt-2 text-3xl font-extrabold text-emerald-500">@Model.CompletedCourseCount</p>
            </div>
            <p class="mt-4 border-t-2 border-gray-200 pt-4 text-xs leading-5 text-gray-500">
                Tüm derslerini bitirdiğiniz kurs sayısı.
            </p>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Tamamlanan Ders</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
                        </svg>
                    </div>
                </div>
                <p class="mt-2 text-3xl font-extrabold text-orange-500">@Model.CompletedLessonCount</p>
            </div>
            <p class="mt-4 border-t-2 border-gray-200 pt-4 text-xs leading-5 text-gray-500">
                Toplam @Model.TotalLessonCount dersten tamamladığınız sayı.
            </p>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Tamamlanma Oranı</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-rose-50 text-rose-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                        </svg>
                    </div>
                </div>
                <p class="mt-2 text-3xl font-extrabold text-rose-500">%@Model.OverallProgressPercentage</p>
            </div>
            <p class="mt-4 border-t-2 border-gray-200 pt-4 text-xs leading-5 text-gray-500">
                Kayıtlı kurslarınızdaki genel ilerleme yüzdeniz.
            </p>
        </div>
    </section>

    <section class="rounded-2xl border-2 border-gray-200 bg-white overflow-hidden">
        <div class="p-6 border-b-2 border-gray-200 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-gray-900">Genel Öğrenme İlerlemesi</h2>
                    <p class="text-xs text-gray-500">@Model.TotalLessonCount dersten @Model.CompletedLessonCount tanesini tamamladınız.</p>
                </div>
                <div class="inline-flex items-center rounded-xl border-2 border-indigo-100 bg-indigo-50 px-3 py-1.5 text-sm font-extrabold text-indigo-500">
                    %@Model.OverallProgressPercentage
                </div>
            </div>
            <div class="h-3.5 overflow-hidden rounded-full border-2 border-indigo-100 bg-indigo-50 p-0.5">
                <div class="h-full rounded-full bg-indigo-500" style="width: @Model.OverallProgressPercentage%;"></div>
            </div>
        </div>

        <div class="p-6 space-y-5">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Kazanılan Rozetler</h3>
                    <p class="mt-0.5 text-xs text-gray-500">Dersleri ve kursları tamamladıkça kazandığınız rozetler burada gösterilir.</p>
                </div>
                <span class="rounded-full bg-indigo-50 border border-indigo-200 px-3 py-1 text-xs font-bold text-indigo-500">
                    @Model.Badges.Count rozet
                </span>
            </div>

            @if (Model.Badges.Count == 0)
            {
                <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50 p-8 text-center">
                    <div class="mb-3 flex size-11 items-center justify-center rounded-xl bg-white border border-gray-200 text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0"></path>
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-gray-500">Henüz kazanılmış bir rozet yok.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-4 gap-4">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="flex flex-col items-center text-center rounded-2xl border-2 border-gray-200 bg-gray-50 p-5">
                            <div class="flex size-12 items-center justify-center rounded-xl bg-white border-2 border-indigo-100 text-2xl shadow-2xs">
                                @badge.Icon
                            </div>
                            <h4 class="mt-3 text-sm font-bold text-gray-900">@badge.Name</h4>
                            <p class="mt-1 text-xs text-gray-500">@badge.Description</p>
                            <span class="mt-3 rounded-full bg-white border border-gray-200 px-2.5 py-0.5 text-[11px] font-semibold text-gray-500">
                                @badge.EarnedAt.ToLocalTime().ToString("dd.MM.yyyy")
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@if (User.IsInRole(ApplicationRoles.Instructor))
{
    <section class="grid grid-cols-2 gap-4">
        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Oluşturulan Kurs</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                        </svg>
                    </div>
                </div>
                <p class="mt-2 text-3xl font-extrabold text-orange-500">@Model.InstructorCourseCount</p>
                <p class="mt-1 text-xs text-gray-500">Yayınladığınız kursları, bölümleri ve öğrenci sayılarını yönetin.</p>
            </div>
            <div class="mt-4 border-t-2 border-gray-200 pt-4">
                <a asp-controller="Courses" asp-action="MyCourses" class="inline-flex items-center gap-1 text-xs font-bold text-orange-500 hover:text-orange-700">
                    <span>Kurslarımı Yönet</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Hızlı İşlem</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                    </div>
                </div>
                <h3 class="mt-2 text-lg font-bold text-gray-900">Yeni Kurs Oluştur</h3>
                <p class="mt-1 text-xs leading-5 text-gray-500">
                    Öğrencileriniz için yeni bir kurs tanımlayın, bölümler ve ders materyalleri ekleyin.
                </p>
            </div>
            <div class="mt-4 border-t-2 border-gray-200 pt-4">
                <a asp-controller="Courses" asp-action="Create" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-500 hover:text-indigo-700">
                    <span>Yeni Kurs Ekle</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
}

@if (User.IsInRole(ApplicationRoles.Admin))
{
    <section class="grid grid-cols-2 gap-4">
        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Yönetim</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                        </svg>
                    </div>
                </div>
                <h3 class="mt-2 text-lg font-bold text-gray-900">Yönetici Paneli</h3>
                <p class="mt-1 text-xs leading-5 text-gray-500">
                    Platform istatistiklerini ve açılan tüm kursları tek yerden kontrol edin.
                </p>
            </div>
            <div class="mt-4 border-t-2 border-gray-200 pt-4">
                <a asp-controller="Admin" asp-action="Index" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-500 hover:text-indigo-700">
                    <span>Yönetici Paneline Git</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 stroke-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border-2 border-gray-200 bg-white p-6">
            <div>
                <div class="flex items-center justify-between">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Sınıflandırma</p>
                    <div class="flex size-9 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
