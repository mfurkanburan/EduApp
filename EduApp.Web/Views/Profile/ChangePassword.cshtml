@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<section class="relative overflow-hidden bg-white border-2 border-gray-200 p-6 rounded-2xl max-w-2xl mx-auto">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-44 z-0 opacity-60">
        <svg class="h-full w-full stroke-indigo-300/30 text-indigo-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="edit-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#edit-grid-pattern)"></rect>
        </svg>
        <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 space-y-6">
        <div class="flex flex-col items-center text-center space-y-6">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 border-2 border-indigo-100 text-indigo-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
            </div>
            <div>
                <h2 class="text-2xl font-extrabold text-gray-900">
                    Şifre Değiştir
                </h2>
                <p class="text-xs font-medium text-gray-500 max-w-sm mt-2">
                    Hesabınızın güvenliği için güçlü ve daha önce kullanmadığınız bir şifre belirleyin.
                </p>
            </div>
        </div>

        <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="space-y-6">            
            <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-500 text-xs font-medium rounded-xl px-3.5 py-2.5"></div>

            <div class="space-y-1.5">
                <label asp-for="CurrentPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Mevcut Şifre</label>
                <input asp-for="CurrentPassword" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="CurrentPassword" class="text-xs text-rose-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="NewPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Yeni Şifre</label>
                <input asp-for="NewPassword" type="password" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="NewPassword" class="text-xs text-rose-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="ConfirmNewPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wide">Şifreyi Onayla</label>
                <input asp-for="ConfirmNewPassword" type="password" class="h-10 flex items-center w-full bg-gray-50 border-2 border-gray-200 rounded-xl text-sm font-medium focus:bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <span asp-validation-for="ConfirmNewPassword" class="text-xs text-rose-500"></span>
            </div>

            <div class="flex items-center space-x-4 bg-indigo-50 border border-indigo-200 text-indigo-500 text-xs font-medium rounded-xl px-3.5 py-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <div class="flex flex-col space-y-2">
                    <strong>Parola Kuralları</strong>
                    <ul class="list-disc list-inside">
                        <li>Şifre en az <strong>8 karakter</strong> olmalıdır.</li>
                        <li>En az bir <strong>büyük harf</strong> içermelidir.</li>
                        <li>En az bir <strong>küçük harf</strong> içermelidir.</li>
                        <li>En az bir <strong>rakam</strong> içermelidir.</li>
                    </ul>
                </div>
            </div>

            <div class="flex items-center justify-end gap-4 border-t-2 border-gray-200 pt-4 mb-0">
                <a asp-controller="Profile" asp-action="Index" class="h-11 px-4 flex items-center justify-center bg-white border-2 border-b-4 text-sm active:border-b-2 border-gray-200 font-bold text-gray-500 rounded-xl shrink-0">
                    Vazgeç
                </a>

                <button type="submit" class="h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 text-sm cursor-pointer active:border-b-2 border-indigo-600 font-bold text-white rounded-xl">
                    Şifre Değiştir
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}