@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr" class="bg-gray-100 text-gray-900">
<head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] &mdash; EduApp</title>

	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="p-6 max-w-7xl mx-auto">

<header>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:px-0 px-6">
        <!-- Logo -->
        <div class="flex items-center justify-self-start">
			<div class="w-10 h-10 bg-indigo-500 rounded-2xl text-base text-white flex items-center justify-center font-black border-2 border-indigo-600 border-b-4 mr-2">
				E
			</div>
			<span class="text-2xl font-black tracking-tight text-indigo-500">EduApp</span>
			<span class="text-xs font-bold text-gray-500 ml-2">v1.0.0</span>
		</div>

        <!-- Navigation -->
        <nav class="p-1 flex items-center space-x-1 bg-white border-2 border-gray-200 rounded-full justify-self-center">
			<a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2 @(currentController == "Home" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
					<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
				</svg>
				<span>Ana Sayfa</span>
			</a>
			<a asp-controller="Courses" asp-action="Index" class="flex items-center space-x-2 @(currentController == "Courses" || currentController == "CourseSections" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"></path>
				</svg>
				<span>Kurslar</span>
			</a>
			@if (User.IsInRole(ApplicationRoles.Student))
			{
				<a asp-controller="Enrollments" asp-action="MyCourses" class="flex items-center space-x-2 @(currentController == "Enrollments" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
						<path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
					</svg>
					<span>Kurslarım</span>
				</a>
			}
			@if (User.IsInRole(ApplicationRoles.Admin))
			{
				<a asp-controller="Categories" asp-action="Index" class="flex items-center space-x-2 @(currentController == "Categories" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
					</svg>
					<span>Kategoriler</span>
				</a>
			}
		</nav>

		<!-- Authentication -->
		@if (User.Identity?.IsAuthenticated == true)
		{
			<div class="bg-white border-2 border-gray-200 p-1 rounded-full justify-self-end">
				<div class="flex items-center space-x-2.5">
					<img src="https://avatars.githubusercontent.com/u/101507088" class="size-10 rounded-full p-0.5 border-2 border-indigo-500">
					<div class="flex flex-col">
						<span class="text-sm font-bold">@User.Identity.Name</span>
						<span class="text-xs font-bold text-indigo-500 uppercase">
							@if (User.IsInRole(ApplicationRoles.Student))
							{
								@:Öğrenci
							}
							else if (User.IsInRole(ApplicationRoles.Instructor))
							{
								@:Eğitmen
							}
							else if (User.IsInRole(ApplicationRoles.Admin))
							{
								@:Yönetici
							}
							else
							{
								@:Bilinmiyor
							}
						</span>
					</div>
					<form asp-controller="Account" asp-action="Logout" method="post">
						<button type="submit" class="flex items-center justify-center size-10 rounded-full p-0.5 text-rose-500 bg-rose-100 hover:bg-rose-200 cursor-pointer">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"></path>
							</svg>
						</button>
					</form>
				</div>
			</div>
		}
		else
		{
			<div class="p-1 flex items-center space-x-1 bg-white border-2 border-gray-200 rounded-full justify-self-end">
				<a asp-controller="Account" asp-action="Login" class="flex items-center space-x-2 @(currentController == "Account" && currentAction == "Login" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
					</svg>
					<span>Giriş Yap</span>
				</a>
				<a asp-controller="Account" asp-action="Register" class="flex items-center space-x-2 @(currentController == "Account" && currentAction == "Register" ? "bg-indigo-100 text-indigo-500 rounded-full" : "text-gray-500") px-4 py-3 font-bold text-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 stroke-2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z"></path>
					</svg>
					<span>Kayıt Ol</span>
				</a>
			</div>
		}
	</div>
</header>

<main class="my-6 space-y-6">
    @RenderBody()
</main>

<footer class="border-t-2 border-gray-200">
	<div class="h-20 flex items-center justify-between">
		<div class="text-sm font-light text-gray-500">&copy; @DateTime.Now.Year EduApp. Tüm hakları saklıdır.</div>
		<div class="flex items-center space-x-4 text-sm font-light text-gray-500">
			Developed by <a href="https://github.com/mfurkanburan" target="_blank" class="ml-1 text-indigo-500">mfurkanburan</a>
		</div>
	</div>
</footer>

<!-- Scripts -->
<script src="~/lib/preline/preline.js" asp-append-version="true"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>