@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<section class="relative overflow-hidden bg-white border-2 border-rose-200 p-16 rounded-2xl max-w-2xl mx-auto">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-44 z-0 opacity-60">
        <svg class="h-full w-full stroke-rose-300/30 text-rose-300/25" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <defs>
                <pattern id="error-grid-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="currentColor" stroke-width="0.75"></path>
                    <circle cx="14" cy="14" r="1.25" fill="currentColor"></circle>
                </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" fill="url(#error-grid-pattern)"></rect>
        </svg>
        <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-white to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col items-center text-center space-y-6">
        <div class="w-14 h-14 rounded-2xl bg-rose-50 border-2 border-rose-100 text-rose-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
        </div>

        <div>
            <h1 class="text-2xl font-extrabold text-gray-900">Bir Hata Oluştu</h1>
            <p class="text-xs font-medium text-gray-500 max-w-sm mt-2">
                İsteğiniz işlenirken beklenmeyen bir hata meydana geldi. Lütfen daha sonra tekrar deneyin.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="rounded-xl border-2 border-gray-200 bg-gray-50 px-4 py-2 text-xs text-gray-500">
                <span class="font-bold">İstek Kimliği:</span>
                <code class="ml-1 font-semibold text-gray-700">@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home" asp-action="Index" class="h-11 px-6 flex items-center justify-center bg-indigo-500 border-2 border-b-4 active:border-b-2 border-indigo-600 text-xs font-bold text-white rounded-xl">
            Ana Sayfaya Dön
        </a>
    </div>
</section>